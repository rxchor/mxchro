# Optional. Without overrides, settings and DB share %APPDATA%/mxchro-native/.
# Without APPDATA, use ./mxchro-native/.
# Default DB: %APPDATA%/mxchro-native/macros.polodb.
# The override preserves the existing layout: <path with .polodb extension>/macros.polodb.
# Use an exclusive native Mxchro path, never the original database without a backup.
# MACROS_FILE_PATH=./mxchro-native-dev.polodb

# Appearance preferences: full file path, absolute or relative to the launch directory.
# If omitted or empty, use %APPDATA%/mxchro-native/settings.toml.
# Does not move the previous file; copy it manually to preserve preferences.
# MXCHRO_SETTINGS_PATH=./settings.toml

# env_logger filter: mxchro limits messages to application code.
# Levels from least to most detail: off, error, warn, info, debug and trace.
# info: errors, warnings, CRUD operations and lifecycle (recommended).
# debug: adds macro activation and self-interference protection.
# trace: adds detailed keyboard/mouse events; produces many messages and
# may reveal keys used. Avoid when typing sensitive information.
# Examples: RUST_LOG=mxchro=debug or RUST_LOG=mxchro=trace.
# To include dependencies: RUST_LOG=warn,mxchro=debug.
RUST_LOG=mxchro=info
